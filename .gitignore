.venv/
/run.log
/results.tsv
/results_bench.tsv
/research_log.md
__pycache__/
vendor/
baselines/*.log
.venv-eval/

# raw market data is not redistributed; rebuild with the fetch scripts (sha256 pins in data/**/manifest*.json)
data/**/*.csv
data/**/*.parquet

# deployment rebuild (2026-11): raw downloads and derived files stay local
data/**/raw/
data/fin/build_report.json
data/fin/listing_um.json
data/fin/universe.json
data/fin/universe_candidates.txt
data/gas/DAILY_CSV_HAS_NO_WEATHER.txt
data/gas/build_report_storage.json
data/power/gaps.json
runs/*/search/ckpt/

# realised market values used by the deployment audit (not redistributed)
runs/**/*_LABELS_local*.npz

# daily runs: full forecast arrays stay local (sha256 recorded in the committed results.json); files that carry
# sealed ex-ante forecasts (gas_preds, wti_preds, exante_*) are committed as proof
runs/deploy_daily/*/fin/preds/fin_preds_*.npz
runs/deploy_daily/*/power/preds/power_preds.npz
